library(tidyr)
library(sidrar)
library(dplyr)
library(REAT)

# Scrip baseado em:
# https://adrianofigueiredo.netlify.app/post/economia-regional-em-r-indicadores-de-analise-cv-v-w-e-theil/


# Tabela 6579 - Projeção da população dos municipios do IBGE
pop = get_sidra(x = 6579, 
                period = c("2011-2021"),
                geo = "City",
                geo.filter = list("State" = 22))

# Tabela 5938 - Produto interno bruto dos municipios
# Puxamos as seguintes variaveis
# - produto interno bruto dos municipios
# - vab total, impostos e vab por setor produtivo
# - participação do pib do municipio no total do estado
pib_mun = get_sidra(x = 5938, 
                variable = c(37, 497, 543, 498, 513, 517, 6575, 525),
                period = c("2011-2021"),
                geo = "City",
                geo.filter = list("State" = 22))

# to do: criar as duas ultimas variaveis
pib_mun = as_tibble(pib_mun)
pop = as_tibble(pop)

tmp = pib_mun %>%
  select("Município", "Ano", "Variável", "Valor") %>%
  pivot_wider(
    names_from = "Ano", 
    values_from = "Valor"
  ) %>%
  filter(Variável == "Produto Interno Bruto a preços correntes")

pop_wider = pop %>%
  select("Município", "Ano", "Variável", "Valor") %>%
  pivot_wider(
    names_from = "Ano", 
    values_from = "Valor"
  )

tmp = pib_mun %>%
  select("Município", "Ano", "Variável", "Valor") %>%
  pivot_wider(
    names_from = "Ano", 
    values_from = "Valor"
  ) %>%
  filter(Variável == "Produto Interno Bruto a preços correntes")

anos = paste(c(2011:2021))

for(ano in anos) {
  tmp = tmp %>%
    mutate(!! paste(ano, "pibpc", sep = "") := (tmp[ano]/tmp2[ano])[,1])
}

anos_capita = paste(c(2011:2021), "pibpc", sep = "")

pibpc = tmp %>% select(all_of(anos_capita))

cvs.pibpc = apply(pibpc, MARGIN = 2, cv)

# Plot cv no tempo
plot(c(2011:2021), cvs.pibpc, "l", xlab = "Ano", ylab = "CV do PIB per capita", 
     main = "CV dos PIB per capita municipais do Piauí, 2011-2021")

cvsn.pibpc = apply(pibpc, MARGIN = 2, FUN = cv, coefnorm = TRUE)

# Plot cv no tempo
plot(c(2011:2021), cvsn.pibpc, "l", xlab = "Ano", ylab = "CV do PIB per capita", 
     main = "CV normalizado dos PIB per capita municipais do Piauí, 2011-2021")