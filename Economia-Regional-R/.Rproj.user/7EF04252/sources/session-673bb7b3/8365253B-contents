# Para ler/escrever arquivos no formato do excel
library(readxl)
# Para fazer o cálculo do QL
library(EconGeo)
# Para baixar shapefiles dos municípios
library(geobr)

library(dplyr)
library(ggplot2)
library(sf)
library(ggspatial)


emprego2024 = read_excel('../Dados/vinculos-CNAE-municipio2024.xlsx',
                         skip = 2, n_max = 224)

nomes = emprego2024[,1]

mat2024 = as.matrix(emprego2024[ , 2:ncol(emprego2024)])

QL_T1 = as.data.frame(round(rca(mat2024), digits = 4))
QL_T1 = cbind(nomes, QL_T1)

shapefilePI = read_municipality(code_muni=22, year=2024)


codigosIBGE = read_excel('../Dados/codigoIBGE.xlsx')

QL_T1_AGR <- QL_T1$`AGRICULTURA, PECUÁRIA E SERVIÇOS RELACIONADOS`
QL_T1_shapefile = left_join(codigosIBGE, QL_T1, by = c("Município-Piauí"))
QL_T1_shapefile = left_join(shapefilePI, QL_T1_shapefile, by = c("code_muni"))


ggplot() + 
  geom_sf(data = QL_T1_shapefile, aes(fill = `AGRICULTURA, PECUÁRIA E SERVIÇOS RELACIONADOS`), 
                   color = NA, size = 0.15) + 
  labs(title = "QL 2024 dos Municípios do PI para AGRIC", 
       caption = "Fonte: Elaboração própria", size = 8) +
  scale_fill_distiller(palette = "RdGy", name = "QL_T1") + 
  theme_minimal() + 
  annotation_north_arrow(location = "br", which_north = "true", 
                         pad_y = unit(0.3, "in"), 
                         style = north_arrow_fancy_orienteering) + 
  annotation_scale(location = "br", width_hint = 0.3)

